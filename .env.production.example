# Production Environment Configuration Template
# Copy this to .env.production and fill in your values

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-production-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-ada-002

# Neo4j Configuration (Production)
NEO4J_URI=bolt://neo4j-production:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=strong-production-password-here

# SQLite Configuration
SQLITE_DB_PATH=/app/data/graphrag.db

# Application Configuration
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE=10485760

# CORS Configuration (Update with your production frontend URLs)
CORS_ORIGINS=["https://your-domain.com"]

# Security
SECRET_KEY=your-secret-key-here-use-strong-random-value
